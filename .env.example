# Copy this file to .env and fill in your own values.
# This file belongs to the bot operator — streamers who use your bot
# never see or need these values.

DISCORD_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: paste server ID here during development so slash commands
# appear instantly in that server instead of an hour later.
DEV_GUILD_ID=

# Optional: how often to re-check every linked server.
SYNC_INTERVAL_MINUTES=30

# Optional: where to store the SQLite database file.
DB_PATH=schedule_sync.db
